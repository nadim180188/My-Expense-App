<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <!-- টাইমলাইনের লাইন এবং ডট -->
    <LinearLayout
        android:layout_width="40dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal">
        
        <View
            android:layout_width="2dp"
            android:layout_height="12dp"
            android:background="#E0E0E0"/>
            
        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@color/purple_primary"
            android:backgroundTint="@color/purple_primary"/>
            
        <View
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:background="#E0E0E0"/>
    </LinearLayout>

    <!-- মূল কার্ড -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- তারিখ এবং সময় -->
            <LinearLayout
                android:orientation="vertical"
                android:background="#F4F4F4"
                android:padding="10dp"
                android:gravity="center"
                android:layout_width="60dp"
                android:layout_height="wrap_content">
                <TextView android:id="@+id/tvDateDay" android:textSize="18sp" android:textStyle="bold" android:textColor="#2D2D2D" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/tvDateMonth" android:textSize="12sp" android:textColor="#777777" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- খরচের নাম, ক্যাটাগরি, স্ট্যাটাস এবং সময় -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content">
                
                <TextView android:id="@+id/tvTitle" android:textSize="16sp" android:textStyle="bold" android:textColor="#2D2D2D" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp" android:gravity="center_vertical">
                    <TextView android:id="@+id/tvCategory" android:textSize="12sp" android:textColor="#6C63FF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    
                    <!-- ★ নতুন স্ট্যাটাস টেক্সট -->
                    <TextView android:id="@+id/tvStatus" android:textSize="12sp" android:textStyle="bold" android:layout_marginStart="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    
                    <TextView android:id="@+id/tvTime" android:textSize="12sp" android:textColor="#777777" android:layout_marginStart="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>

            <!-- টাকার পরিমাণ এবং অ্যাকশন -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">
                
                <TextView
                    android:id="@+id/tvAmount"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#2D2D2D"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <ImageView
                        android:id="@+id/btnEdit"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@android:drawable/ic_menu_edit"
                        android:layout_marginEnd="12dp"
                        app:tint="#6C63FF"/>
                    <ImageView
                        android:id="@+id/btnDelete"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@android:drawable/ic_menu_delete"
                        app:tint="#FF5252"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
